# ================================================================
# RecruitAI Platform — Environment Configuration
# ================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to Git — it is in .gitignore.
# ================================================================

# ─── Server ────────────────────────────────────────────────────
# Local dev: 127.0.0.1 | Docker/Production: 0.0.0.0
HOST=127.0.0.1
PORT=8000

# ─── CORS — Frontend Origins ───────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local dev:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Docker (add frontend container URL):
# CORS_ORIGINS=http://localhost:5173,http://frontend:5173
# Production (replace with your Vercel/domain URL):
# CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com

# ─── Database ──────────────────────────────────────────────────
# SQLite (default, great for dev & small deployments):
DATABASE_URL=sqlite:///./recruiter_ats.db
# PostgreSQL (for production at scale — requires psycopg2 installed):
# DATABASE_URL=postgresql://user:password@host:5432/recruitai_db

# ─── File Upload ───────────────────────────────────────────────
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=temp_uploads
OUTPUT_DIR=output

# ─── Security ──────────────────────────────────────────────────
# IMPORTANT: Generate a strong random key for production!
# Run: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ─── AI / External APIs (Optional) ────────────────────────────
# Add your API keys here if integrating with external services
# OPENAI_API_KEY=
# COHERE_API_KEY=
